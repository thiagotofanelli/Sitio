generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Property {
  id           String   @id @default(uuid())
  title        String
  description  String
  city         String   @default("Juquitiba")
  state        String   @default("SP")
  maxGuests    Int      @default(100)
  maxDayUse    Int      @default(200)
  cleaningFee  Float    @default(200.0)
  depositFee   Float    @default(1000.0)
  createdAt    DateTime @default(now())
}

model PricingTier {
  id           String   @id @default(uuid())
  category     String
  peopleCount  Int
  price        Float
  validityNote String?
}

model BlockedDate {
  id        String   @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model BookingInquiry {
  id             String   @id @default(uuid())
  guestName      String
  guestEmail     String
  guestPhone     String
  eventType      String
  startDate      DateTime
  endDate        DateTime
  guestCount     Int
  estimatedTotal Float
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
}

model AdminUser {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         String @default("ADMIN")
}

model SiteImage {
  id          String   @id @default(uuid())
  section     String   @default("GALLERY") // "HERO", "GALLERY", "ACCOMMODATION"
  category    String   @default("Piscina & Lazer")
  url         String
  label       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}
